{
  "name": "@talent-signal/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && pnpm --filter @talent-signal/workspace-ui build && next build",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "start": "next start",
    "lint": "eslint app components lib proxy.ts proxy.test.ts next.config.ts vitest.config.ts postcss.config.mjs",
    "typecheck": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && pnpm --filter @talent-signal/workspace-ui build && tsc6 --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.29",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@sinclair/typebox": "^0.34.41",
    "@talent-signal/agent": "workspace:*",
    "@talent-signal/contracts": "workspace:*",
    "@talent-signal/workspace-ui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mammoth": "^1.13.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  }
