{
  "name": "@talent-signal/eval-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && pnpm --filter @talent-signal/evaluation build && tsc6 -p tsconfig.build.json",
    "typecheck": "pnpm --filter @talent-signal/contracts build && pnpm --filter @talent-signal/agent build && pnpm --filter @talent-signal/evaluation build && tsc6 -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "check": "pnpm typecheck && pnpm test",
    "validate": "tsx src/cli.ts validate",
    "list": "tsx src/cli.ts list",
    "replay": "tsx src/cli.ts replay",
    "p0": "tsx src/cli.ts p0",
    "opik:check": "tsx src/cli.ts opik-check",
    "opik:sync": "tsx src/cli.ts opik-sync",
    "opik:annotations": "tsx src/cli.ts opik-annotation-bootstrap",
    "opik:delete": "tsx src/cli.ts opik-delete",
    "opik:export": "tsx src/cli.ts opik-export",
    "optimization": "tsx src/cli.ts optimization",
    "phase-one": "tsx src/cli.ts phase-one"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@talent-signal/agent": "workspace:*",
    "@talent-signal/contracts": "workspace:*",
    "@talent-signal/evaluation": "workspace:*",
    "opik": "2.2.80"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  }
}
