{
  "manifest_version": 3,
  "name": "capri Capture",
  "version": "0.2.0",
  "description": "Review visible evidence before a user-approved local capri handoff.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "desktopCapture"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Review this page in capri"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Open the capri review panel"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
