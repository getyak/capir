{
  "name": "@talent-signal/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    },
    "./prompt-registry": {
      "types": "./dist/promptRegistry.d.ts",
      "import": "./dist/promptRegistry.js"
    },
    "./chat-answer-provider": {
      "types": "./dist/chatAnswerProvider.d.ts",
      "import": "./dist/chatAnswerProvider.js"
    },
    "./contact-intake": {
      "types": "./dist/contactIntakeSchemas.d.ts",
      "import": "./dist/contactIntakeSchemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @talent-signal/contracts build && tsc6 -p tsconfig.build.json",
    "typecheck": "pnpm --filter @talent-signal/contracts build && tsc6 -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@talent-signal/contracts": "workspace:*",
    "quickjs-emscripten": "0.32.0",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.3"
  }
}
