    "Some client stages exceeded the recording limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some client stages exceeded the recording limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分客户端阶段超出记录上限。"
          }
        }
      }
    },
    "Client stages may contain other stages and network requests. State updated means the store changed, not that a frame rendered or the task became usable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client stages may contain other stages and network requests. State updated means the store changed, not that a frame rendered or the task became usable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端区间可能包含其他阶段与网络请求。“状态已更新”表示状态存储发生变化，不代表画面已渲染或任务已可操作。"
          }
        }
      }
    },
    "Client operation timeline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client operation timeline"
          }
        },
        "zh-Hans": {
