            "state": "translated",
            "value": "保存已审阅的修改，不会更新现有 Apple 日历日程。"
          }
        }
      }
    },
    "Saves the reviewed changes, then retries adding one Apple Calendar event.": {
      "localizations": {
        "zh-Hans": {
