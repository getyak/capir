      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认来源"
          }
        }
      }
    },
    "Understanding this message…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在理解这条消息…"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        }
      }
    },
    "Unread": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读"
          }
        }
      }
    },
    "Unresolved": {
