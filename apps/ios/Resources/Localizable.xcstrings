    "Retry the same decision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试同一决定"
          }
        }
      }
    },
    "Review a CSV or vCard before adding people.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人前先审阅 CSV 或 vCard。"
