      }
    },
    "The original stays on this device for up to 7 days, or until review is complete. Turn off to keep only reviewed text when saved. The image is never uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原图仅在本机保留，最多 7 天，或在审阅完成时移除。关闭后，保存时只保留审阅文字。原图不会上传。"
          }
        }
      }
    },
    "The source is attached. Each fact still needs your decision.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
