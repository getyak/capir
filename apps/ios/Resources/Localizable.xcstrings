    "MetricKit summaries could not be read. Existing files were preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 MetricKit 摘要，已保留现有文件。"
          }
        }
      }
    },
    "MetricKit reception paused. Saved summaries remain on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停接收 MetricKit 报告，已保存的摘要仍保留在本机。"
          }
        }
      }
    },
    "MetricKit summaries could not be saved. Retry storage or clear them.": {
      "localizations": {
