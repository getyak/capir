          }
        }
      }
    },
    "Server offsets use the server's monotonic clock. They cannot be subtracted from device timestamps. Adapter spans can include tools and overlap other spans; they are not first-token timing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server offsets use the server's monotonic clock. They cannot be subtracted from device timestamps. Adapter spans can include tools and overlap other spans; they are not first-token timing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器时间偏移使用自身单调时钟，不能与设备时间戳相减。适配器区间可能包含工具调用并与其他区间重叠，不代表首个 token 的耗时。"
          }
        }
      }
    },
    "Server stages": {
      "localizations": {
