      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认"
          }
        }
      }
    },
    "Unconfirmed public avatar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认的公开头像"
          }
        }
      }
    },
    "Unconfirmed public profile for %@ on %@": {
      "localizations": {
