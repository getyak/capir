      }
    },
    "Local MetricKit summaries cleared. System reports and exported copies are separate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除本机 MetricKit 摘要，系统报告和导出副本独立保留。"
          }
        }
      }
    },
    "MetricKit summaries could not be cleared. Existing files were preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法清除 MetricKit 摘要，已保留现有文件。"
          }
        }
      }
