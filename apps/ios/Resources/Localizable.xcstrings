          }
        }
      }
    },
    "Account recovery needs the configured web address for this connection, which this build does not have. Retry after configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次连接缺少已配置的网页地址，无法打开账户核对。配置完成后可以重试。"
