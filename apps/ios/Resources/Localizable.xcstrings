      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始文件"
          }
        }
      }
    },
    "Reading contacts on this device…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此设备上读取联系人…"
