    "This email is linked to two historical accounts with separate data. Resolve it in Account settings on the web; nothing is merged automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个邮箱关联了两个历史账户，数据各自独立。请在网页端的账号设置中完成核对；系统不会自动合并。"
          }
        }
      }
    },
