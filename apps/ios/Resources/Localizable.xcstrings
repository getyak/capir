            "state": "translated",
            "value": "显示回调：%.1f Hz"
          }
        }
      }
    },
    "Each row is one client attempt. TLS can overlap connection time; phase durations must not be summed. Unfinished requests may still complete outside this recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each row is one client attempt. TLS can overlap connection time; phase durations must not be summed. Unfinished requests may still complete outside this recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行表示一次客户端请求。TLS 与连接耗时可能重叠，不应直接相加。未完成的请求可能在停止记录后继续完成。"
          }
        }
      }
    },
