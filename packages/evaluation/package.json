{
  "name": "@talent-signal/evaluation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @talent-signal/contracts build && tsc6 -p tsconfig.build.json",
    "typecheck": "pnpm --filter @talent-signal/contracts build && tsc6 -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@talent-signal/contracts": "workspace:*"
  }
}
