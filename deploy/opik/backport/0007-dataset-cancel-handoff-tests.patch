+// SPDX-License-Identifier: Apache-2.0
+package com.comet.opik.domain;
+
+import com.clickhouse.client.api.Client;
+import com.clickhouse.client.api.query.QueryResponse;
+import com.clickhouse.client.api.query.QuerySettings;
+import com.comet.opik.api.DatasetItemEdit;
+import com.comet.opik.api.sorting.SortingFactoryDatasets;
+import com.comet.opik.domain.experiments.aggregations.ExperimentAggregatesDAO;
+import com.comet.opik.domain.filter.FilterQueryBuilder;
+import com.comet.opik.domain.sorting.SortingQueryBuilder;
+import com.comet.opik.infrastructure.OpikConfiguration;
+import com.comet.opik.infrastructure.auth.RequestContext;
+import com.comet.opik.infrastructure.db.TransactionTemplateAsync;
+import com.comet.opik.infrastructure.db.ZeroRowsRetryPolicy;
+import com.comet.opik.testutil.Get337QueryResponseFixture;
+import org.junit.jupiter.api.Timeout;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import reactor.core.Disposable;
+import reactor.core.publisher.Mono;
+import reactor.core.scheduler.Schedulers;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyMap;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Exercises the real copy/edit DAO chain after future delivery but before its
+ * boundedElastic mapper runs. Only the external Client.query boundary is mocked.
+ * The schedule hook decorates one task submitted while this test completes its
+ * own future; unrelated threads and every other task retain their runnable.
+ */
+@Timeout(15)
+class Get337DatasetQueryHandoffOwnershipTest {
+
+    private static final UUID SOURCE_DATASET = UUID.fromString("00000000-0000-0000-0000-000000000001");
+    private static final UUID SOURCE_VERSION = UUID.fromString("00000000-0000-0000-0000-000000000002");
+    private static final UUID TARGET_DATASET = UUID.fromString("00000000-0000-0000-0000-000000000003");
+    private static final UUID TARGET_VERSION = UUID.fromString("00000000-0000-0000-0000-000000000004");
+    private static final UUID ITEM = UUID.fromString("00000000-0000-0000-0000-000000000005");
+    private static final UUID NEW_ROW = UUID.fromString("00000000-0000-0000-0000-000000000006");
+
+    enum Operation {
+        COPY("copy_version_items:"),
+        EDIT("edit_item_via_select_insert:");
+
+        private final String logCommentPrefix;
+
+        Operation(String logCommentPrefix) {
+            this.logCommentPrefix = logCommentPrefix;
+        }
+    }
+
+    @ParameterizedTest
+    @EnumSource(Operation.class)
+    void cancellationAfterDeliveryClosesResponseBeforeTheQueuedMapperRuns(Operation operation) throws Exception {
+        var pending = new CompletableFuture<QueryResponse>();
+        var fixture = Get337QueryResponseFixture.successful();
+        var scenario = scenario(operation, pending);
+        var values = new AtomicInteger();
+        var completions = new AtomicInteger();
+        var deliveredError = new AtomicReference<Throwable>();
+        var gate = new HandoffGate();
+        var completing = new ThreadLocal<Boolean>();
+        Thread completionThread = Thread.currentThread();
+        String hookKey = "get337-query-handoff-" + UUID.randomUUID();
+        Disposable subscription = null;
+
+        Schedulers.onScheduleHook(hookKey, task -> {
+            if (Thread.currentThread() == completionThread && Boolean.TRUE.equals(completing.get())
+                    && gate.armed.compareAndSet(true, false)) {
+                gate.captures.incrementAndGet();
+                return () -> gate.pauseThenRun(task);
+            }
+            return task;
+        });
+        try {
+            subscription = scenario.operation().subscribe(value -> values.incrementAndGet(),
+                    deliveredError::set, completions::incrementAndGet);
+            assertThat(scenario.queryCalls().get()).isEqualTo(1);
+            assertThat(scenario.logComment().get()).startsWith(operation.logCommentPrefix);
+
+            completing.set(true);
+            try {
+                assertThat(pending.complete(fixture.response())).isTrue();
+            } finally {
+                completing.remove();
+            }
+            assertThat(pending.join()).isSameAs(fixture.response());
+            assertThat(gate.entered.await(2, TimeUnit.SECONDS))
+                    .as("The actual scheduled handoff must reach its barrier before cancellation").isTrue();
+            assertThat(gate.captures.get()).isEqualTo(1);
+            assertThat(gate.delegations.get()).isZero();
+            assertThat(fixture.closeCount()).isZero();
+            assertThat(values.get()).isZero();
+            assertThat(completions.get()).isZero();
+
+            subscription.dispose();
+
+            // No mapper or default scheduler tick is allowed to return the response for us.
+            assertThat(gate.release.getCount()).isEqualTo(1L);
+            assertThat(gate.delegations.get()).isZero();
+            assertThat(fixture.awaitClosed())
+                    .as("Cancellation after delivery must close the response while its mapper remains paused").isTrue();
+            assertThat(fixture.closeCount()).isEqualTo(1);
+            assertThat(values.get()).isZero();
+            assertThat(deliveredError.get()).isNull();
+            assertThat(completions.get()).isZero();
+            assertThat(scenario.queryCalls().get()).isEqualTo(1);
+
+            gate.release.countDown();
+            assertThat(gate.exited.await(2, TimeUnit.SECONDS))
+                    .as("Observe the captured runnable finish, rather than waiting a guessed scheduler tick").isTrue();
+            assertThat(gate.failure.get()).isNull();
+            assertThat(gate.delegations.get()).isEqualTo(1);
+            assertThat(fixture.closeCount()).isEqualTo(1);
+            assertThat(values.get()).isZero();
+            assertThat(deliveredError.get()).isNull();
+            assertThat(completions.get()).isZero();
+            assertThat(scenario.queryCalls().get()).isEqualTo(1);
+        } finally {
+            completing.remove();
+            try {
+                if (subscription != null) {
+                    subscription.dispose();
+                }
+                gate.release.countDown();
+                if (gate.entered.getCount() == 0) {
+                    assertThat(gate.exited.await(2, TimeUnit.SECONDS))
+                            .as("Release this test's captured runnable even when an assertion fails").isTrue();
+                }
+            } finally {
+                Schedulers.resetOnScheduleHook(hookKey);
+                // Only failure-path fixture cleanup; it occurs after the paused ownership assertion.
+                if (fixture.closeCount() == 0) {
+                    fixture.response().close();
+                }
+            }
+        }
+    }
+
+    /**
+     * Public schedule decoration pauses before invoking the original runnable.
+     * Cancellation can interrupt the worker: interruption is recorded and restored,
+     * but only explicit release (or the finite guard deadline) ends the barrier.
+     */
+    private static final class HandoffGate {
+        private final AtomicBoolean armed = new AtomicBoolean(true);
+        private final AtomicInteger captures = new AtomicInteger();
+        private final AtomicInteger delegations = new AtomicInteger();
+        private final AtomicReference<Throwable> failure = new AtomicReference<>();
+        private final CountDownLatch entered = new CountDownLatch(1);
+        private final CountDownLatch release = new CountDownLatch(1);
+        private final CountDownLatch exited = new CountDownLatch(1);
+
+        private void pauseThenRun(Runnable task) {
+            boolean interrupted = false;
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(8);
+            entered.countDown();
+            try {
+                for (;;) {
+                    long remaining = deadline - System.nanoTime();
+                    if (remaining <= 0) {
+                        failure.set(new AssertionError("Timed out awaiting explicit handoff release"));
+                        return;
+                    }
+                    try {
+                        if (!release.await(remaining, TimeUnit.NANOSECONDS)) {
+                            failure.set(new AssertionError("Timed out awaiting explicit handoff release"));
+                            return;
+                        }
+                        break;
+                    } catch (InterruptedException ignored) {
+                        interrupted = true;
+                    }
+                }
+                delegations.incrementAndGet();
+                task.run();
+            } catch (Throwable error) {
+                failure.set(error);
+            } finally {
+                if (interrupted) {
+                    Thread.currentThread().interrupt();
+                }
+                exited.countDown();
+            }
+        }
+    }
+
+    private Scenario scenario(Operation operation, CompletableFuture<QueryResponse> response) {
+        Client client = mock(Client.class);
+        var calls = new AtomicInteger();
+        var logComment = new AtomicReference<String>();
+        when(client.query(anyString(), anyMap(), any(QuerySettings.class))).thenAnswer(invocation -> {
+            calls.incrementAndGet();
+            QuerySettings settings = invocation.getArgument(2);
+            logComment.set((String) settings.getAllSettings().get("clickhouse_setting_log_comment"));
+            return response;
+        });
+
+        var dao = new DatasetItemVersionDAOImpl(
+                mock(TransactionTemplateAsync.class),
+                mock(FilterQueryBuilder.class),
+                mock(SortingQueryBuilder.class),
+                mock(SortingFactoryDatasets.class),
+                mock(OpikConfiguration.class),
+                mock(ExperimentAggregatesDAO.class),
+                client,
+                new ZeroRowsRetryPolicy(1, Duration.ofMillis(1), Duration.ofMillis(1)));
+
+        Mono<Long> result = switch (operation) {
+            case COPY -> dao.copyVersionItems(SOURCE_DATASET, SOURCE_VERSION, TARGET_DATASET, TARGET_VERSION,
+                    null, List.of(NEW_ROW));
+            case EDIT -> dao.editItemsViaSelectInsert(SOURCE_DATASET, SOURCE_VERSION, TARGET_DATASET, TARGET_VERSION,
+                    List.of(DatasetItemEdit.builder().id(ITEM).description("Synthetic handoff test edit").build()),
+                    List.of(NEW_ROW));
+        };
+        return new Scenario(result.contextWrite(context -> context
+                .put(RequestContext.USER_NAME, "get337-synthetic-user")
+                .put(RequestContext.WORKSPACE_ID, "get337-synthetic-workspace")),
+                calls, logComment);
+    }
+
+    private record Scenario(Mono<Long> operation, AtomicInteger queryCalls, AtomicReference<String> logComment) {
+    }
+}
