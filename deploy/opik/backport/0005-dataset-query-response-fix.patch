+    /**
+     * Owns a v2 query response across future delivery, scheduled mapping and cancellation.
+     * Callers must not close the response themselves. This is deliberately QueryResponse-only;
+     * insert responses have a different transport ownership contract.
+     *
+     * <p>Suppressing future cancellation lets a late response reach the discard cleanup. Once
+     * delivered, usingWhen owns cleanup even if cancellation precedes the scheduled mapper.
+     * Cleanup runs inline so returning a connection does not wait behind queued blocking work.
+     * A cleanup failure must not turn an already completed write into an error or a retry.
+     *
+     * <p>Adapted from upstream OPIK-8576 (PR 8606); the existing context helpers are unchanged.
+     */
+    public static <R> Mono<R> usingClickHouseQueryFuture(
+            @NonNull Supplier<? extends CompletableFuture<QueryResponse>> futureSupplier,
+            @NonNull Function<? super QueryResponse, ? extends R> consume,
+            @NonNull Scheduler consumeScheduler) {
+        return Mono.usingWhen(
+                Mono.fromFuture(futureSupplier, true)
+                        .doOnDiscard(QueryResponse.class, AsyncUtils::closeQueryResponseQuietly),
+                response -> Mono.<R>fromCallable(() -> consume.apply(response)).subscribeOn(consumeScheduler),
+                response -> Mono.fromRunnable(() -> closeQueryResponseQuietly(response)));
+    }
+
+    private static void closeQueryResponseQuietly(QueryResponse response) {
+        try {
+            response.close();
+        } catch (Exception exception) {
+            log.warn("Failed to close ClickHouse query response (exception type '{}')",
+                    exception.getClass().getName());
+        }
+    }
+
     public interface ContextAwareAction<T> {
         Mono<T> subscriberContext(String userName, String workspaceId);
     }
