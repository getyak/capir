+            }
+
+            @Override
+            public InputStream createDataInputStream() {
+                return InputStream.nullInputStream();
+            }
+
+            @Override
+            public void close() throws IOException {
+                closes.incrementAndGet();
+                closed.countDown();
+                if (failClose) {
+                    throw new IOException("Synthetic transport close failure");
+                }
+            }
+        };
+
+        response = new QueryResponse(transport, ClickHouseFormat.RowBinaryWithNamesAndTypes,
