# Local synthetic development only. Do not reuse these values outside localhost.
POSTGRES_DB=talent_signal_local
POSTGRES_USER=talent_signal_local
POSTGRES_PASSWORD=talent_signal_local_only
TALENT_SIGNAL_RESEARCH_ALLOW_SYNTHETIC_DNS_GATEWAY=false

# Bounded Agent provider. Deterministic is the safe default. Remote providers
# remain server-only, require one explicitly pinned model, and are hard-limited
# to synthetic source evidence until a provider is admitted for private data.
TALENT_SIGNAL_AGENT_PROVIDER=deterministic
TALENT_SIGNAL_AGENT_MODEL=
TALENT_SIGNAL_AGENT_REFERER=http://localhost:3000
ANTHROPIC_API_KEY=
# Use exactly one official/litellm credential. Hao requires its separate key.
ANTHROPIC_AUTH_TOKEN=
HAO_ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Blank auto-enables the SDK task-budget field only for api.anthropic.com.
# Set true only when a compatible proxy explicitly supports output_config.task_budget.
TALENT_SIGNAL_CLAUDE_TASK_BUDGET_ENABLED=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Web AI admission. Every flag defaults false and no credential is committed
# here. TALENT_SIGNAL_AI_ENABLED admits the bounded Web text analysis and,
# together with the sensitive-processing gate, screenshot analysis.
# TALENT_SIGNAL_ALLOW_PUBLIC_AI_DEMO additionally admits the unauthenticated
# public synthetic-conversation demo route in production; that demo sends only
# the typed synthetic conversation text to the pinned model provider on a
# shared 8/minute per-process budget with bounded Retry-After. Forwarded
# headers are never trusted for cost isolation, and the budget is not a
# distributed limiter: a public deployment needs its own trusted edge control.
TALENT_SIGNAL_AI_ENABLED=false
TALENT_SIGNAL_ALLOW_PUBLIC_AI_DEMO=false
TALENT_SIGNAL_SCREENSHOT_PROVIDER=auto
TALENT_SIGNAL_OPENROUTER_SCREENSHOT_MODEL=
TALENT_SIGNAL_OPENROUTER_PROVIDER_ORDER=
TALENT_SIGNAL_OPENROUTER_PROXY_URL=
TALENT_SIGNAL_LLM_MODEL_GENERAL=
TALENT_SIGNAL_LLM_MODEL_HEAVY=
TALENT_SIGNAL_LLM_MODEL_FAST=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Evidence-bounded Relationship Ask. The iOS app never receives ZHIPU_API_KEY;
# it calls the backend, which sends only the user's question and minimum
# reviewed relationship context after an explicit Send action.
TALENT_SIGNAL_ALLOW_REMOTE_CHAT_PROCESSING=false
TALENT_SIGNAL_CHAT_PROVIDER=disabled
TALENT_SIGNAL_CHAT_MODEL=glm-5.3
# Optional governed image understanding. This model is used only when both
# remote Chat and sensitive-AI processing are explicitly admitted.
TALENT_SIGNAL_CHAT_VISION_MODEL=
TALENT_SIGNAL_CHAT_TIMEOUT_MS=15000
POSTGRES_PORT=55432
BACKEND_PORT=4317
TALENT_SIGNAL_API_BASE_URL=http://127.0.0.1:4317
# Optional TLS mode for this backend process. This changes its one listener
# from HTTP to HTTPS; it does not add a second port. Run a separate loopback
# backend process/port for Hybrid so existing Web/iOS HTTP clients are not
# migrated accidentally. Both paths are required together; keep the private
# key owner-only and paste only the public certificate into the Hybrid app.
TALENT_SIGNAL_TLS_CERTIFICATE_PATH=
TALENT_SIGNAL_TLS_PRIVATE_KEY_PATH=
SESSION_TTL_SECONDS=28800
SIMULATED_AUTH_ENABLED=true
PASSWORD_AUTH_ENABLED=true
PASSWORD_REGISTRATION_ENABLED=true
APPLE_SIGN_IN_ENABLED=false
APPLE_SIGN_IN_AUDIENCES=com.talentsignal.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Chat image attachments are scoped task media, not governed evidence. Local
# storage is suitable for development. Production can use AWS S3 or an
# S3-compatible service; credentials use the standard AWS SDK environment or
# workload identity chain.
CHAT_MEDIA_STORAGE_PROVIDER=local
CHAT_MEDIA_LOCAL_DIRECTORY=.data/chat-media
CHAT_MEDIA_S3_BUCKET=
CHAT_MEDIA_S3_REGION=
CHAT_MEDIA_S3_ENDPOINT=
CHAT_MEDIA_S3_FORCE_PATH_STYLE=false

# Authenticated recruiter dictation. Audio is sent only after recording stops;
# credentials remain server-side and the transcript returns as an editable
# draft. Voice processing has its own admission gate so enabling dictation does
# not admit screenshots or other private evidence to remote models.
TALENT_SIGNAL_ALLOW_REMOTE_VOICE_TRANSCRIPTION=false
TALENT_SIGNAL_ALLOW_SENSITIVE_AI_PROCESSING=false
VOICE_ASR_PROVIDER=disabled
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
# Kept for other Doubao products that require HMAC. The flash ASR endpoint uses
# App ID plus Access Token and does not transmit this value.
DOUBAO_ASR_SECRET_KEY=
